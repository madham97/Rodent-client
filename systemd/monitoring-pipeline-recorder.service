[Unit]
Description=Monitoring Pipeline - Audio Recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Rodent-client
ExecStart=/opt/Rodent-client/venv/bin/python3 /opt/Rodent-client/pi-client/recorder.py --config /opt/Rodent-client/config/client.json
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
