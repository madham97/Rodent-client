[Unit]
Description=Monitoring Pipeline - GSM SIM PIN Unlock
After=sysinit.target
Before=monitoring-pipeline-gsm.service

[Service]
Type=oneshot
ExecStart=/opt/Rodent-client/venv/bin/python3 /opt/Rodent-client/scripts/gsm-pin-unlock.py
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
