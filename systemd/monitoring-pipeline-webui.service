[Unit]
Description=Monitoring Pipeline - Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Rodent-client
EnvironmentFile=/opt/Rodent-client/config/webui.env
ExecStart=/opt/Rodent-client/venv/bin/python3 /opt/Rodent-client/pi-client/web_ui.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
