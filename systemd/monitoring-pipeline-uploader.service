[Unit]
Description=Monitoring Pipeline - Uploader
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/monitoring-pipeline
ExecStart=/opt/monitoring-pipeline/venv/bin/python3 /opt/monitoring-pipeline/pi-client/uploader.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
