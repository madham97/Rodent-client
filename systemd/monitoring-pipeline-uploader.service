[Unit]
Description=Monitoring Pipeline - Uploader
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/Rodent-client
ExecStart=/opt/Rodent-client/venv/bin/python3 /opt/Rodent-client/pi-client/uploader.py --config /opt/Rodent-client/config/client.json
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
